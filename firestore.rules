rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /nexusAccountVaults/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['encryptedVault', 'updatedAt', 'schemaVersion'])
        && request.resource.data.encryptedVault is string
        && request.resource.data.encryptedVault.size() <= 2097152
        && request.resource.data.schemaVersion == 1;
    }
    match /pluginMarketplace/{packageId} {
      allow read: if resource.data.visibility == 'public'
        || (request.auth != null && request.auth.uid == resource.data.ownerUid);
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.uid == request.resource.data.ownerUid
        && request.resource.data.visibility in ['public', 'private']
        && request.resource.data.keys().hasOnly(['pluginId', 'name', 'version', 'description', 'capabilities', 'visibility', 'digest', 'packageDigest', 'signed', 'screened', 'ownerUid', 'packageId', 'objectName', 'updatedAt']);
      allow update: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.uid == resource.data.ownerUid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.packageId == resource.data.packageId
        && request.resource.data.visibility in ['public', 'private']
        && request.resource.data.keys().hasOnly(['pluginId', 'name', 'version', 'description', 'capabilities', 'visibility', 'digest', 'packageDigest', 'signed', 'screened', 'ownerUid', 'packageId', 'objectName', 'updatedAt']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }
  }
}
