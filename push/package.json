{
  "name": "nexus-devos",
  "version": "1.0.0",
  "description": "Nexus Developer OS - a real desktop control panel for local dev projects",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis",
    "dist:publish": "electron-builder --win nsis --publish always"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nexus.devos",
    "productName": "Nexus",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "package.json",
      "updater.js",
      "projectCloner.js",
      "projectSettings.js",
      "projectRegistry.js",
      "pureLogic.js"
    ],
    "publish": {
      "provider": "github",
      "owner": "jonathanblunt1214-lgtm",
      "repo": "Nexus-"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
