  "healthContract": {
    "checks": [
      "credential-present-at-runtime",
      "authentication-succeeds",
      "required-injection-capability-succeeds",
      "expiration-observed-when-provider-exposes-it",
      "maximum-token-lifetime-not-greater-than-30-days",
      "expired-or-expiring-state"
    ],
    "persistOnly": [
      "status",
      "checkedAt",
      "present",
      "authenticated",
      "capabilityVerified",
      "expiresAt",
      "daysRemaining",
      "expiresSoon",
      "healthy",
      "renewalRequired",
      "reason"
    ],
    "neverPersist": [
      "token",
      "token-value",
      "authorization-header",
      "credential-payload"
    ]
  },
  "lifecycle": {
    "maximumLifetimeDays": 30,
    "expiryAction": "Require a fresh injection-only credential cycle for the same authorized Nexus target before further protected injection/assimilation checks.",
    "renewalDoesNotExpandAuthority": true,
    "disableAfterInjectionOrAssimilation": true
  },
