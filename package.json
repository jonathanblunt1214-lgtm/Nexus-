{
  "name": "nexus-devos",
  "version": "1.0.2",
  "description": "Nexus Developer OS - a real desktop control panel for local dev projects. Now with TypeScript, React, and Vite support.",
  "main": "bootstrap.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "audit:architecture": "node scripts/verifyArchitecture.js",
    "audit:release": "node scripts/releaseAudit.js",
    "privacy:verify": "node scripts/verifyRepositoryPrivacy.js",
    "privacy:scrub": "node scripts/scrubRepositoryPrivacy.js",
    "privacy:retry": "node scripts/privacyRetryGate.js",
    "prepare": "node scripts/installGitHooks.js",
    "inventory:update": "node scripts/verifyRepositoryInventory.js --write",
    "inventory:verify": "node scripts/verifyRepositoryInventory.js",
    "inventory:repair": "node scripts/repairRepositoryInventory.js",
    "repository:clutter": "node scripts/repositoryClutterAudit.js",
    "repository:maintain": "node scripts/repositoryMaintenance.js",
    "release:crucible": "node scripts/releaseStressGate.js",
    "release:stress": "npm run release:crucible",
    "dist": "electron-builder --win nsis",
    "dist:local-signed": "node scripts/buildLocalSigned.js",
    "signing:renew-local": "pwsh -NoProfile -File scripts/renew-local-signing.ps1",
    "signing:restore-local": "pwsh -NoProfile -File scripts/restore-local-signing.ps1",
    "dist:publish": "node scripts/buildAndPublishVerified.js",
    "inventory:package": "node scripts/verifyPackagedContents.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.9",
    "js-yaml": "^5.3.0",
    "libsodium-wrappers": "^0.8.4",
    "pyright": "^1.1.413",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "~5.8.2",
    "vscode-css-languageservice": "^6.3.10",
    "vscode-html-languageservice": "^5.6.2",
    "vscode-json-languageservice": "^6.0.0-next.3",
    "vscode-languageserver-textdocument": "^1.0.12",
    "web-tree-sitter": "0.26.12"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "tsx": "^4.21.0"
  },
  "build": {
    "appId": "com.nexus.devos",
    "productName": "Nexus",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "bootstrap.js",
      "ipcSecurity.js",
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "package.json",
      "CONSTITUTION.md",
      "updater.js",
      "projectCloner.js",
      "projectSourceInput.js",
      "projectLaunchPreflight.js",
      "repository-file-manifest.json",
      "projectPortDetector.js",
      "backgroundGitSync.js",
      "projectSettings.js",
      "projectRegistry.js",
      "pureLogic.js",
      "pipelineEngine.js",
      "githubClient.js",
      "githubGitAuth.js",
      "oauthIntegrations.js",
      "publisherConfig.js",
      "wordpressComClient.js",
      "googleDriveClient.js",
      "accountVault.js",
      "firebaseAccountClient.js",
      "codingModelProviders.js",
      "providerDiscovery.js",
      "gitWorkflow.js",
      "debugAdapter.js",
      "portableProjectConfig.js",
      "operationalDiagnostics.js",
      "secretScanner.js",
      "advancedTesting.js",
      "gameProjectDetector.js",
      "codeLibrary.js",
      "projectTemplates.js",
      "fullStackSupport.js",
      "aiInventory.js",
      "inventoryWorker.js",
      "atomicWrite.js",
      "buildNumber.js",
      "astEngine.js",
      "workspaceIndexer.js",
      "semanticWorker.js",
      "semanticContext.js",
      "agentOrchestrator.js",
      "toolRegistry.js",
      "governanceEngine.js",
      "evalsEngine.js",
      "memoryEngine.js",
      "visualContext.js",
      "runtimeDebugger.js",
      "section7Ipc.js",
      "pluginManifest.js",
      "pluginRuntime.js",
      "pluginWorker.js",
      "pluginManager.js",
      "pluginSecurityScanner.js",
      "pluginMarketplaceClient.js",
      "section8Ipc.js",
      "aiMetrics.js",
      "aiGuardrailTester.js",
      "aiUpgradeOrchestrator.js",
      "promptTesting.js",
      "dependencyAuditor.js",
      "complianceMonitor.js",
      "changelogGenerator.js",
      "knowledgeBase.js",
      "experimentationFramework.js",
      "aiRecommendations.js",
      "aiAlerts.js",
      "aiCostOptimizer.js",
      "aiPerformanceTuner.js",
      "languageBreakdown.js",
      "languageIntelligence.js",
      "webDevelopmentKnowledge.js",
      "trainingDataset.js",
      "fineTuneTrainer.js",
      "codeChecker.js",
      "projectExportProtection.js",
      "webLanguageServices.js",
      "officialLanguageServers.js",
      "officialDevelopmentPlatforms.js",
      "THIRD_PARTY_NOTICES.md",
      "scripts/train_lora.py",
      "learning_sources/AGENTS.md.txt",
      "learning_sources/scriptsprocess_logs.py.txt",
      "learning_sources/system_instruction.md.txt",
      "learning_sources/TECHNICAL_MANUAL.md.txt",
      "learning_sources/SPEC.md.txt",
      "release-notes.md"
    ],
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    },
    "publish": {
      "provider": "github",
      "owner": "jonathanblunt1214-lgtm",
      "repo": "Nexus-"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
