{
  "name": "nexus-devos",
  "version": "1.1.0",
  "description": "Nexus Developer OS - a real desktop control panel for local dev projects. Now with TypeScript, React, and Vite support.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "audit:architecture": "node scripts/verifyArchitecture.js",
    "dist": "electron-builder --win nsis",
    "dist:publish": "electron-builder --win nsis --publish always"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "typescript": "~5.8.2",
    "tsx": "^4.21.0",
    "@types/node": "^26.2.0"
  },
  "build": {
    "appId": "com.nexus.devos",
    "productName": "Nexus",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "package.json",
      "updater.js",
      "projectCloner.js",
      "projectSettings.js",
      "projectRegistry.js",
      "pureLogic.js",
      "pipelineEngine.js",
      "githubClient.js",
      "fullStackSupport.js",
      "processManager.js",
      "aiInventory.js",
      "inventoryWorker.js",
      "atomicWrite.js",
      "aiMetrics.js",
      "aiGuardrailTester.js",
      "aiUpgradeOrchestrator.js",
      "promptTesting.js",
      "dependencyAuditor.js",
      "complianceMonitor.js",
      "changelogGenerator.js",
      "knowledgeBase.js",
      "experimentationFramework.js",
      "aiRecommendations.js",
      "aiAlerts.js",
      "aiCostOptimizer.js",
      "aiPerformanceTuner.js",
      "languageBreakdown.js"
    ],
    "publish": {
      "provider": "github",
      "owner": "jonathanblunt1214-lgtm",
      "repo": "Nexus-"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
